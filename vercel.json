{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/mongodb-config.js",
      "dest": "/mongodb-config.js"
    },
    {
      "src": "/admin.js",
      "dest": "/admin.js"
    },
    {
      "src": "/owner-dashboard.js",
      "dest": "/owner-dashboard.js"
    },
    {
      "src": "/admin-panel.css",
      "dest": "/admin-panel.css"
    },
    {
      "src": "/owner-dashboard.css",
      "dest": "/owner-dashboard.css"
    },
    {
      "src": "/(.*\\.(mp4|jpg|jpeg|png|gif|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
