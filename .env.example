# Environment Variables Template
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000

# MongoDB Connection String
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/turfbooking

# MongoDB Atlas (Cloud) - Uncomment and use this for cloud database
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/turfbooking?retryWrites=true&w=majority

# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/turfbooking?retryWrites=true&w=majority
